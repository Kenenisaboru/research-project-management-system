##############################################################################
# RPMS — Environment Configuration Example
# Copy this file to .env and fill in all values before running the app.
##############################################################################

# ============================================================================
# Core Application
# ============================================================================
APP_NAME="Gambella University RPMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# ============================================================================
# Database
# ============================================================================
# Development: SQLite (default)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Production: MySQL — uncomment and fill in
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rpms_production
# DB_USERNAME=rpms_user
# DB_PASSWORD=your_strong_password_here

# ============================================================================
# Cache & Session
# ============================================================================
# Development: file / array
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Production with Redis: uncomment
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis

# ============================================================================
# Queue
# ============================================================================
QUEUE_CONNECTION=database
# Production with Redis: QUEUE_CONNECTION=redis

# ============================================================================
# Redis (required when CACHE_DRIVER=redis or QUEUE_CONNECTION=redis)
# ============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================================
# Mail
# ============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gambellauniversity.edu.et
MAIL_PASSWORD=your_app_specific_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@gambellauniversity.edu.et
MAIL_FROM_NAME="Gambella University RPMS"

# ============================================================================
# Logging
# ============================================================================
LOG_CHANNEL=stack
LOG_LEVEL=debug
# Production: LOG_LEVEL=warning

# ============================================================================
# RPMS Application Settings
# ============================================================================

# Seed demo data (MUST be false in production)
RPMS_SEED_DEMO_DATA=false

# Show demo login role buttons (enable only on a private demo deployment)
RPMS_SHOW_DEMO_ACCOUNTS=false

# Overdue project threshold in months (default: 12)
RPMS_OVERDUE_MONTHS=12

# Budget over-utilisation alert threshold (%) (default: 90)
RPMS_BUDGET_ALERT_PERCENT=90

# Backup retention in days (default: 30)
RPMS_BACKUP_RETENTION_DAYS=30

# Enable daily scheduled backup (true/false)
RPMS_SCHEDULED_BACKUP=true

# 2FA TOTP issuer name (shown in authenticator apps)
RPMS_2FA_ISSUER="Gambella University RPMS"

# Maximum file upload size in MB (must match php.ini upload_max_filesize)
RPMS_MAX_UPLOAD_MB=10

# Session idle timeout in minutes (should match SESSION_LIFETIME)
RPMS_SESSION_TIMEOUT_MINUTES=120

# Password rotation warning period in days (0 = disabled)
RPMS_PASSWORD_ROTATION_DAYS=90

# Start supervisord queue worker in Docker entrypoint (true/false)
RPMS_ENABLE_QUEUE_WORKER=false

# Financial governance threshold (ETB): budgets >= this value go to RCSC/VP
RPMS_DEAN_APPROVAL_LIMIT=500000

# Notification polling interval in seconds (client-side)
RPMS_NOTIFICATION_POLL_INTERVAL=30